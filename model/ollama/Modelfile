FROM qwen2.5:0.5b

# Reduce context window to keep KV-cache memory under control
# on Render free tier (512 MB RAM).
# 1024 tokens is enough for the structured code assistant prompt.
PARAMETER num_ctx 1024

# Keep temperature low for deterministic structured answers
PARAMETER temperature 0.1

# Suppress verbose reasoning preambles
PARAMETER stop "<|im_end|>"
PARAMETER stop "<|endoftext|>"
